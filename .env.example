# The Assay: copy to .env.local for development. Never commit real values.

# Network the site runs on. Mainnet stays closed in code (MAINNET_OPEN) until the written go.
NEXT_PUBLIC_NETWORK=devnet

# Our LaunchLab platform config on each network (created by `npm run platform:create`).
NEXT_PUBLIC_PLATFORM_ID_DEVNET=2nQcifUC6ZX7bL4T83iuyAHZ9auVfi9EdhE543HjUdXM
NEXT_PUBLIC_PLATFORM_ID_MAINNET=

# RPC. The browser uses NEXT_PUBLIC_RPC_URL; the indexer and rewards run use RPC_URL (a keyed provider; Helius, Triton, QuickNode...).
NEXT_PUBLIC_RPC_URL=https://api.devnet.solana.com
RPC_URL=

# Postgres (Supabase, Neon, Vercel Postgres...). POSTGRES_URL is accepted too (what the Vercel integrations set). Unset = embedded PGlite in PGLITE_DIR (development only).
DATABASE_URL=
PGLITE_DIR=.pglite
# The database is marked with its network on first start. An older database with data but no mark and no coins is refused;
# set this to the network once to adopt it anyway. Leave unset otherwise.
DB_NETWORK_CLAIM=

# Bearer token the Vercel cron sends to /api/cron/*. Required in production.
CRON_SECRET=

# Rewards hot wallet (JSON array secret key) that withdraws Token-2022 fees and pays holders. Keep its balance small.
REWARDS_KEYPAIR=

# Optional: Vercel Blob for coin images and metadata (otherwise stored in the database and served from /api/files/:id).
BLOB_READ_WRITE_TOKEN=

# Public URL used in metadata links and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
